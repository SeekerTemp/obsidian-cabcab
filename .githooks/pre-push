#!/bin/sh
# Refuses to push vault data onto a branch meant to carry only plugins and
# settings.
#
# .gitignore keeps data/ out of new commits, but it has no effect on files that
# are already tracked — so a merge from a data/<name> branch, or a stray
# `git add -f`, can still carry the whole vault onto main. This is the net that
# catches that, because by then .gitignore is not looking.
#
# Enable with:  git config core.hooksPath .githooks

ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/heads/main|refs/heads/feature/*) ;;
		*) continue ;;
	esac

	# Deleting a remote branch pushes nothing.
	[ "$local_sha" = "$ZERO" ] && continue

	if [ "$remote_sha" = "$ZERO" ]; then
		# New branch on the remote: judge the whole tree, not a range.
		files=$(git ls-tree -r --name-only "$local_sha" -- data)
	else
		# Deletions are excluded: dropping data/ from a branch is the whole
		# point of these rules, so a push that only removes it must go through.
		files=$(git diff --name-only --diff-filter=ACMRT "$remote_sha" "$local_sha" -- data)
	fi

	if [ -n "$files" ]; then
		count=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
		echo "pre-push: refusing to push vault data to ${remote_ref#refs/heads/}." >&2
		echo "  $count file(s) under data/ are in this push, for example:" >&2
		printf '%s\n' "$files" | head -5 | sed 's/^/    /' >&2
		echo "" >&2
		echo "  data/ belongs on a data/<name> branch. main and feature/* carry" >&2
		echo "  plugins and settings only. To move a plugin fix off a data branch," >&2
		echo "  cherry-pick the commit rather than merging the branch." >&2
		exit 1
	fi

	# The mirror of the rule above, in the other direction. A feature branch
	# tracks only the plugins it develops against, so merging one into main would
	# arrive as "every other plugin deleted". main is the only branch holding the
	# full set, and nothing is allowed to thin it out by accident.
	[ "$remote_ref" = "refs/heads/main" ] || continue
	[ "$remote_sha" = "$ZERO" ] && continue

	gone=$(git diff --name-only --diff-filter=D "$remote_sha" "$local_sha" -- .obsidian/plugins)
	if [ -n "$gone" ]; then
		count=$(printf '%s\n' "$gone" | wc -l | tr -d ' ')
		echo "pre-push: refusing to remove plugins from main." >&2
		echo "  $count file(s) under .obsidian/plugins/ are deleted by this push:" >&2
		printf '%s\n' "$gone" | head -5 | sed 's/^/    /' >&2
		echo "" >&2
		echo "  A feature branch tracks only the plugins it needs, so merging one" >&2
		echo "  into main deletes the rest. Cherry-pick the plugin commits instead." >&2
		echo "  Really uninstalling a plugin? Push that on its own with --no-verify." >&2
		exit 1
	fi
done

exit 0
